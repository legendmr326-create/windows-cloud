{
  "name": "Windows-Look Cloud Desktop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-desktop.sh",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {"label": "Desktop (noVNC)", "onAutoForward": "openBrowser"}
  },
  "customizations": {
    "codespaces": {"openFiles": ["README.md"]}
  }
}
